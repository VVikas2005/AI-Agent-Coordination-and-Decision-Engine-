# AI Agent Coordination & Decision Engine
# Safe configuration template. Copy this file to .env and fill in your own values.
# This file must be named ".env.example" in the repo; your real file must be named ".env".
# NEVER commit .env. Keys never go in Git or the group chat.

# ---------------------------------------------------------------
# Application
# ---------------------------------------------------------------
APP_NAME=AI Agent Coordination & Decision Engine
# On the cloud server set APP_ENV=production and DEBUG=false
APP_ENV=development
DEBUG=true
API_PREFIX=/api/v1
LOG_LEVEL=INFO

# ---------------------------------------------------------------
# API authentication (API keys)
# Generate each key with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# API_KEY         : used by the dashboard and normal API calls
# FINANCE_API_KEY : the ONLY key allowed to approve or reject paused runs
# The app must refuse to start in production if either value is empty.
# ---------------------------------------------------------------
API_KEY=
FINANCE_API_KEY=

# ---------------------------------------------------------------
# LLM provider keys (each member creates their own; never share them)
# ---------------------------------------------------------------
GOOGLE_API_KEY=
GROQ_API_KEY=

# ---------------------------------------------------------------
# Real provider model IDs
# Check the current IDs and free limits in Google AI Studio and the
# Groq console before filling these in. Model names change often.
# ---------------------------------------------------------------
# A Gemini Flash-Lite model ID (free tier)
GEMINI_FAST_MODEL=
# A Gemini Flash model ID (free tier)
GEMINI_MAIN_MODEL=
# A Gemma model ID served through the Gemini API (free tier)
GEMMA_MODEL=
GROQ_GPT_OSS_MODEL=openai/gpt-oss-120b

# ---------------------------------------------------------------
# Which model each agent uses
# Aliases: gemini_fast, gemini_main, gemma, groq_gpt_oss
# The code maps each alias to the real model ID above.
# Fallbacks are tried in order (comma separated).
# Groq's free plan has a small tokens-per-minute limit, so keep
# prompts sent to it short.
# ---------------------------------------------------------------
PLANNING_MODEL=gemini_fast
PLANNING_FALLBACK_MODELS=groq_gpt_oss

RESEARCH_MODEL=gemini_fast
RESEARCH_FALLBACK_MODELS=groq_gpt_oss

ANALYSIS_MODEL=gemini_main
ANALYSIS_FALLBACK_MODELS=groq_gpt_oss,gemma

DECISION_MODEL=gemini_main
DECISION_FALLBACK_MODELS=groq_gpt_oss,gemma

# Used by the Execution Agent to write the combined confirmation message
RESPONSE_MODEL=gemini_fast
RESPONSE_FALLBACK_MODELS=gemma

# ---------------------------------------------------------------
# LLM call settings
# ---------------------------------------------------------------
LLM_TEMPERATURE=0
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=3

# ---------------------------------------------------------------
# Optional local model (development only, not available on the cloud server)
# ---------------------------------------------------------------
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma

# ---------------------------------------------------------------
# Databases
# ---------------------------------------------------------------
# MongoDB Atlas connection string (add after the cluster is created)
MONGODB_URI=
MONGODB_DATABASE=ai_agent_coordination

# PostgreSQL (decision trace, run status, workflow checkpoints)
# Format: postgresql://USER:PASSWORD@HOST:5432/DBNAME
POSTGRES_URL=

# Chroma vector database (return / replacement policy documents)
CHROMA_PATH=./chroma_db
CHROMA_COLLECTION=policies

# ---------------------------------------------------------------
# Business rules (read by the Python rules engine, not by the prompts)
# ---------------------------------------------------------------
PAYMENT_APPROVAL_LIMIT=2000
DEFECT_AUTO_APPROVE_LIMIT=2000
RETURN_WINDOW_DAYS=7
MAX_RETURNS_6_MONTHS=3
CONFIDENCE_THRESHOLD=0.7
TOOL_MAX_RETRIES=2

# ---------------------------------------------------------------
# API protection / request limits
# ---------------------------------------------------------------
# /workflows/run makes several LLM calls, so keep its limit low
RATE_LIMIT_RUN_PER_MINUTE=10
RATE_LIMIT_DEFAULT_PER_MINUTE=60
MAX_TICKET_LENGTH=2000

# CORS: allowed frontend origins only. On the cloud server use the
# deployed frontend URL only.
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ---------------------------------------------------------------
# Frontend note
# The React app has its own frontend/.env with ONLY non-secret values
# such as VITE_API_BASE_URL. Never put API keys in it: VITE_ variables
# are visible in the browser.
# ---------------------------------------------------------------
